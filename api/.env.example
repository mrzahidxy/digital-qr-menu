# Server
APP_NAME="QR Menu API"
APP_DESCRIPTION="Backend API for a QR-first cafe digital menu builder with guest ordering."
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
LOG_DB_ENABLED=true
PRISMA_QUERY_LOG=false
TRUST_PROXY=false
RUN_MIGRATIONS_ON_STARTUP=false

# Database
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# Redis (optional)
REDIS_URL="redis://redis:6379"

# JWT
JWT_SECRET="change_me_at_least_16_characters"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_PATH=/api
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
JWT_ISSUER=qr-menu-api
JWT_AUDIENCE=

# CORS
CORS_ORIGIN="https://your-client-domain.com"

# Cloudinary optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload
MAX_UPLOAD_SIZE=5242880
