# Server
APP_NAME="QR Menu API"
APP_DESCRIPTION="Backend API for a QR-first cafe digital menu builder with guest ordering."
PORT=8080
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
LOG_DB_ENABLED=true
PRISMA_QUERY_LOG=false
TRUST_PROXY=false

# Database
DATABASE_URL="postgresql://app_user:app_password@localhost:5433/app_db?schema=public"
DIRECT_URL="postgresql://app_user:app_password@localhost:5433/app_db?schema=public"

# Redis (optional)
REDIS_URL="redis://localhost:6380"

# JWT
JWT_SECRET="super_secret_jwt_key_here_at_least_16_characters"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_PATH=/api
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
JWT_ISSUER=qr-menu-api
JWT_AUDIENCE=

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Client URL
CLIENT_URL="http://localhost:5173"

# Upload
MAX_UPLOAD_SIZE=5242880
